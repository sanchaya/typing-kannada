    "*"
   ]
  },
  {
   "tag": "ZWJ/ZWNJ",
   "word": "‍",
   "gloss": "zero-width joiner — ⌥ + 1",
   "built": "ZWJ sits on the Alternate layer: hold ⌥ and press 1. After a consonant this gives a visible standalone halant (type it, then the next letter to join).",
