   "gloss": "zero-width non-joiner — ⌥ + 2",
   "built": "ZWNJ on ⌥+2 prevents ligation — the parallel of KGP's double-virama trick.",
   "keys": [
    {
     "label": "2",
     "alt": true
    }
   ]
  },
